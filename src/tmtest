
#!/bin/bash

if [ "$#" -ne 2 ]; then
    echo "Usage: tmtest loopcount filename(without extension)"
    exit 1
fi

loop=$1
infile=$2

rm -f "$infile.out"
rm -f "$infile.log"
rm -f "./$infile.log"

count=0
while [ "$count" -lt "$loop" ]; do
    echo "EXECUTION: $count" | tee -a "$infile.out"

    ./zgt_test "$infile.txt" >> "$infile.out"

    count=$((count + 1))
done

./ipcs_cleanup.sh
